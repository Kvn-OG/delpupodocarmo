# Domínio oficial do site (sem barra no final).
# Ativa canonical, og:url, og:image absoluto e gera o sitemap.xml no build.
VITE_SITE_URL=

# Opcional: endpoint que recebe o formulário via POST (JSON),
# ex.: Formspree, Getform ou API própria. Sem ele, o formulário
# abre o WhatsApp com a mensagem pronta para o visitante enviar.
VITE_FORM_ENDPOINT=
